  "health": [
    {
      "id": "health_01",
      "text": "Полностью здоров(а), хронических заболеваний нет."
    },
    {
      "id": "health_02",
      "text": "Близорукость, нужны очки."
    },
    {
      "id": "health_03",
      "text": "Аллергия на пыльцу растений."
    },
    {
      "id": "health_04",
      "text": "Аллергия на некоторые антибиотики."
    },
    {
      "id": "health_05",
      "text": "Слабый иммунитет, часто болеет."
    },
    {
      "id": "health_06",
      "text": "Старая травма колена, трудно бегать."
    },
    {
      "id": "health_07",
      "text": "Периодически болит спина."
    },
    {
      "id": "health_08",
      "text": "Нуждается в ежедневном приёме лекарства."
    },
    {
      "id": "health_09",
      "text": "Нарушение слуха на одно ухо."
    },
    {
      "id": "health_10",
      "text": "Плохо видит в темноте."
    },
    {
      "id": "health_11",
      "text": "Астма лёгкой степени."
    },
    {
      "id": "health_12",
      "text": "Сахарный диабет, необходим контроль питания и лекарств."
    },
    {
      "id": "health_13",
      "text": "Повышенное давление."
    },
    {
      "id": "health_14",
      "text": "Сильная аллергия на укусы пчёл."
    },
    {
      "id": "health_15",
      "text": "Полностью здоров(а), отличная физическая форма."
    },
    {
      "id": "health_16",
      "text": "Отсутствуют два пальца на одной руке."
    },
    {
      "id": "health_17",
      "text": "Перенёс(ла) сложную операцию, восстановился(ась)."
    },
    {
      "id": "health_18",
      "text": "Слабые лёгкие, тяжело переносит дым."
    },
    {
      "id": "health_19",
      "text": "Непереносимость лактозы."
    },
    {
      "id": "health_20",
      "text": "Склонность к укачиванию."
    },
    {
      "id": "health_21",
      "text": "Нуждается в ортопедической обуви."
    },
    {
      "id": "health_22",
      "text": "Есть старая травма плеча."
    },
    {
      "id": "health_23",
      "text": "Плохое зрение, контактные линзы."
    },
    {
      "id": "health_24",
      "text": "Хорошая выносливость, крепкое здоровье."
    },
    {
      "id": "health_25",
      "text": "Частые мигрени."
    },
    {
      "id": "health_26",
      "text": "Нарушение цветового восприятия."
    },
    {
      "id": "health_27",
      "text": "Сильно обгорает на солнце."
    },
    {
      "id": "health_28",
      "text": "Есть зубные протезы."
    },
    {
      "id": "health_29",
      "text": "Восстанавливается после перелома руки."
    },
    {
      "id": "health_30",
      "text": "Здоров(а), но физически очень слаб(а)."
    }
  ],
