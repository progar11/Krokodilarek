  "special_conditions": [
    {
      "id": "special_01",
      "text": "Не может раскрыть свою профессию до второго голосования."
    },
    {
      "id": "special_02",
      "text": "Имеет право один раз поменять свою карту здоровья."
    },
    {
      "id": "special_03",
      "text": "Должен выбрать союзника и голосовать вместе с ним один раунд."
    },
    {
      "id": "special_04",
      "text": "Не может голосовать в первом раунде."
    },
    {
      "id": "special_05",
      "text": "Может задать одному игроку дополнительный вопрос."
    },
    {
      "id": "special_06",
      "text": "Должен раскрыть одну карту по выбору группы."
    },
    {
      "id": "special_07",
      "text": "Его голос считается за два в одном голосовании."
    },
    {
      "id": "special_08",
      "text": "Необходимо убедить группу, что он полезен, не называя профессию."
    },
    {
      "id": "special_09",
      "text": "Может один раз отменить своё выбывание, если большинство согласится."
    },
    {
      "id": "special_10",
      "text": "Должен раскрыть свою фобию сразу."
    },
    {
      "id": "special_11",
      "text": "Получает дополнительное место в бункере для выбранного игрока."
    },
    {
      "id": "special_12",
      "text": "Не может раскрывать багаж до последнего раунда."
    },
    {
      "id": "special_13",
      "text": "Может обменять одну свою карту с закрытой колодой."
    },
    {
      "id": "special_14",
      "text": "Обязан первым рассказать о своих навыках."
    },
    {
      "id": "special_15",
      "text": "Может один раз изменить голос после обсуждения."
    },
    {
      "id": "special_16",
      "text": "Его карта факта раскрывается случайным образом."
    },
    {
      "id": "special_17",
      "text": "Должен выбрать игрока, чью профессию будет защищать."
    },
    {
      "id": "special_18",
      "text": "Не может раскрывать возраст до финального голосования."
    },
    {
      "id": "special_19",
      "text": "Получает право на дополнительную минуту выступления."
    },
    {
      "id": "special_20",
      "text": "Должен раскрыть две карты вместо одной при следующем раскрытии."
    },
    {
      "id": "special_21",
      "text": "Может один раз попросить группу провести повторное голосование."
    },
    {
      "id": "special_22",
      "text": "Его багаж считается общим ресурсом команды."
    },
    {
      "id": "special_23",
      "text": "Не может голосовать против выбранного им союзника."
    },
    {
      "id": "special_24",
      "text": "Может скрыть одну негативную характеристику до конца игры."
    },
    {
      "id": "special_25",
      "text": "Должен рассказать правдивую историю из прошлого персонажа."
    },
    {
      "id": "special_26",
      "text": "При равенстве голосов его голос решающий."
    },
    {
      "id": "special_27",
      "text": "Может предложить обмен картами двум игрокам."
    },
    {
      "id": "special_28",
      "text": "Должен раскрыть профессию, но может скрыть факт."
    },
    {
      "id": "special_29",
      "text": "Получает право последним выступить перед голосованием."
    },
    {
      "id": "special_30",
      "text": "Особых условий нет."
    }
  ],
  "catastrophes": [
    {
      "id": "disaster_01",
      "text": "Глобальная пандемия неизвестного вируса: большая часть населения заражена."
    },
    {
      "id": "disaster_02",
      "text": "Падение крупного астероида вызвало масштабные разрушения и пожары."
    },
    {
      "id": "disaster_03",
      "text": "Ядерная война сделала значительную часть поверхности опасной для жизни."
    },
    {
      "id": "disaster_04",
      "text": "Серия супервулканических извержений закрыла небо пеплом на годы."
    },
    {
      "id": "disaster_05",
      "text": "Глобальное потепление вызвало экстремальную жару и засуху."
    },
    {
      "id": "disaster_06",
      "text": "Мощнейшее землетрясение разрушило большинство крупных городов."
    },
    {
      "id": "disaster_07",
      "text": "Мировой океан поднялся и затопил прибрежные территории."
    },
    {
      "id": "disaster_08",
      "text": "Неизвестный грибок уничтожает основные сельскохозяйственные культуры."
    },
    {
      "id": "disaster_09",
      "text": "Солнечная буря вывела из строя большую часть электроники и энергосетей."
    },
    {
      "id": "disaster_10",
      "text": "Крупная комета вызвала климатическую катастрофу."
    },
    {
      "id": "disaster_11",
      "text": "Химическая авария распространила токсичное облако над несколькими странами."
    },
    {
      "id": "disaster_12",
      "text": "Массовое вымирание пчёл привело к продовольственному кризису."
    },
    {
      "id": "disaster_13",
      "text": "Глобальная война разрушила транспортную и энергетическую инфраструктуру."
    },
    {
      "id": "disaster_14",
      "text": "Необычайно сильные морозы охватили большую часть планеты."
    },
    {
      "id": "disaster_15",
      "text": "Непрерывные ливни вызвали всемирные наводнения."
    },
    {
      "id": "disaster_16",
      "text": "Экспериментальная технология вышла из-под контроля и загрязнила атмосферу."
    },
    {
      "id": "disaster_17",
      "text": "Опасные мутации микроорганизмов сделали многие источники воды непригодными."
    },
    {
      "id": "disaster_18",
      "text": "Цепь мощных цунами уничтожила множество прибрежных поселений."
    },
    {
      "id": "disaster_19",
      "text": "Длительная пыльная буря закрыла солнце и нарушила климат."
    },
    {
      "id": "disaster_20",
      "text": "Неизвестное явление резко изменило состав атмосферы."
    }
  ],
  "threats": [
    {
      "id": "threat_01",
      "text": "Запасы продовольствия заражены неизвестным токсином."
    },
    {
      "id": "threat_02",
      "text": "Вентиляционная система периодически пропускает опасный газ."
    },
    {
      "id": "threat_03",
      "text": "Рядом с бункером замечена агрессивная группа выживших."
    },
    {
      "id": "threat_04",
      "text": "Система фильтрации воды может выйти из строя через месяц."
    },
    {
      "id": "threat_05",
      "text": "В бункере обнаружен источник неизвестной инфекции."
    },
    {
      "id": "threat_06",
      "text": "Электроснабжение нестабильно, топлива осталось мало."
    },
    {
      "id": "threat_07",
      "text": "Вход в бункер постепенно засыпает обломками."
    },
    {
      "id": "threat_08",
      "text": "В районе бункера повышен уровень радиации."
    },
    {
      "id": "threat_09",
      "text": "В помещении есть скрытая неисправность системы пожаротушения."
    },
    {
      "id": "threat_10",
      "text": "Радиосигнал привлёк внимание неизвестных людей."
    },
    {
      "id": "threat_11",
      "text": "Через год запасы кислорода потребуют полной замены системы."
    }
  ],
  "bunker_descriptions": [
    {
      "id": "bunker_01",
      "text": "Подземный бункер на 10 человек. Есть скважина, кухня и небольшая теплица."
    },
    {
      "id": "bunker_02",
      "text": "Военный объект с толстыми стенами, но без собственного источника воды."
    },
    {
      "id": "bunker_03",
      "text": "Старое метро с несколькими залами и работающей вентиляцией."
    },
    {
      "id": "bunker_04",
      "text": "Научная лаборатория с медицинским блоком и оборудованием."
    },
    {
      "id": "bunker_05",
      "text": "Горный бункер, скрытый внутри скалы. Вход только один."
    },
    {
      "id": "bunker_06",
      "text": "Подземное хранилище с большими запасами консервов."
    },
    {
      "id": "bunker_07",
      "text": "Бункер построен под бывшей больницей, есть операционная."
    },
    {
      "id": "bunker_08",
      "text": "Автономный комплекс с солнечными панелями и аккумуляторами."
    },
    {
      "id": "bunker_09",
      "text": "Небольшое убежище под сельской фермой, рядом плодородная земля."
    },
    {
      "id": "bunker_10",
      "text": "Арктическая станция с мощной теплоизоляцией."
    },
    {
      "id": "bunker_11",
      "text": "Подземный командный пункт с радиорубкой и картами местности."
    },
    {
      "id": "bunker_12",
      "text": "Заброшенный шахтёрский комплекс с несколькими уровнями."
    },
    {
      "id": "bunker_13",
      "text": "Бункер под университетом, есть библиотека и мастерские."
    },
    {
      "id": "bunker_14",
      "text": "Старый гражданский бункер, рассчитанный на 20 человек."
    },
    {
      "id": "bunker_15",
      "text": "Подземный склад с инструментами, но почти без еды."
    },
    {
      "id": "bunker_16",
      "text": "Комплекс с теплицей, системой сбора дождевой воды и компостером."
    },
    {
      "id": "bunker_17",
      "text": "Убежище в пустыне: прохладно внутри, но вода строго ограничена."
    },
    {
      "id": "bunker_18",
      "text": "Бункер на острове, защищённый от большинства наземных угроз."
    },
    {
      "id": "bunker_19",
      "text": "Подземный исследовательский центр с лабораторией биологии."
    },
    {
      "id": "bunker_20",
      "text": "Убежище под электростанцией, есть генераторы и запас топлива."
    },
    {
      "id": "bunker_21",
      "text": "Небольшой бункер с одной общей комнатой и двумя спальными отсеками."
    },
    {
      "id": "bunker_22",
      "text": "Бункер с мастерской, токарным станком и набором деталей."
    },
    {
      "id": "bunker_23",
      "text": "Укрытие в горной пещере, укреплённое металлическими дверями."
    },
    {
      "id": "bunker_24",
      "text": "Подземный жилой комплекс с душевыми и системой отопления."
    },
    {
      "id": "bunker_25",
      "text": "Бункер с запасом семян, но без специалистов по сельскому хозяйству."
    },
    {
      "id": "bunker_26",
      "text": "Старый бункер связи с мощной антенной на поверхности."
    },
    {
      "id": "bunker_27",
      "text": "Медицинское убежище с ограниченным запасом лекарств."
    },
    {
      "id": "bunker_28",
      "text": "Подземный комплекс с бассейном для хранения технической воды."
    },
    {
      "id": "bunker_29",
      "text": "Бункер с отдельным складом, который пока невозможно открыть."
    },
    {
      "id": "bunker_30",
      "text": "Убежище на окраине города: удобно добираться, но оно заметно снаружи."
    }
  ],
  "action_cards": [
    {
      "id": "action_01",
      "text": "Обмен: обменяйте одну открытую карту с любым игроком по взаимному согласию."
    },
    {
      "id": "action_02",
      "text": "Разоблачение: выберите игрока — он обязан раскрыть одну случайную закрытую карту."
    },
    {
      "id": "action_03",
      "text": "Защита: отмените один голос против себя в текущем раунде."
    },
    {
      "id": "action_04",
      "text": "Переговоры: получите дополнительную минуту, чтобы убедить группу."
    },
    {
      "id": "action_05",
      "text": "Пересмотр: проведите повторное голосование после короткого обсуждения."
    },
    {
      "id": "action_06",
      "text": "Проверка: задайте одному игроку вопрос, на который он должен ответить честно."
    },
    {
      "id": "action_07",
      "text": "Смена мест: поменяйтесь одной картой с другим игроком, не раскрывая её группе."
    },
    {
      "id": "action_08",
      "text": "Союз: выберите игрока; ваши голоса считаются одним общим голосом в этом раунде."
    },
    {
      "id": "action_09",
      "text": "Тайна: спрячьте одну свою открытую карту до следующего раунда."
    },
    {
      "id": "action_10",
      "text": "Испытание: предложите игроку назвать три способа применить его профессию в бункере."
    },
    {
      "id": "action_11",
      "text": "Дополнительный вопрос: задайте группе вопрос о состоянии бункера."
    },
    {
      "id": "action_12",
      "text": "Вето: отмените действие одной сыгранной карты действия."
    },
    {
      "id": "action_13",
      "text": "Открытая информация: все игроки одновременно раскрывают по одной карте."
    },
    {
      "id": "action_14",
      "text": "Риск: назовите игрока; он раскрывает карту или теряет право голоса в раунде."
