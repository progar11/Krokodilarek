  "facts": [
    {
      "id": "fact_01",
      "text": "Умеет читать азбуку Морзе."
    },
    {
      "id": "fact_02",
      "text": "В детстве жил(а) в деревне."
    },
    {
      "id": "fact_03",
      "text": "Однажды провёл(а) неделю без электричества."
    },
    {
      "id": "fact_04",
      "text": "Знает три иностранных языка."
    },
    {
      "id": "fact_05",
      "text": "Никогда не пользовался(ась) смартфоном."
    },
    {
      "id": "fact_06",
      "text": "Однажды выиграл(а) городской конкурс."
    },
    {
      "id": "fact_07",
      "text": "Умеет ориентироваться по звёздам."
    },
    {
      "id": "fact_08",
      "text": "Коллекционирует старые карты."
    },
    {
      "id": "fact_09",
      "text": "Может починить механические часы."
    },
    {
      "id": "fact_10",
      "text": "Однажды пережил(а) кораблекрушение."
    },
    {
      "id": "fact_11",
      "text": "Знает основы первой помощи."
    },
    {
      "id": "fact_12",
      "text": "Боится замкнутых помещений, но скрывает это."
    },
    {
      "id": "fact_13",
      "text": "Умеет быстро считать в уме."
    },
    {
      "id": "fact_14",
      "text": "Когда-то работал(а) на полярной станции."
    },
    {
      "id": "fact_15",
      "text": "Имеет отличную память на лица."
    },
    {
      "id": "fact_16",
      "text": "Умеет разводить огонь без спичек."
    },
    {
      "id": "fact_17",
      "text": "Однажды заблудился(ась) в лесу на три дня."
    },
    {
      "id": "fact_18",
      "text": "Знает основы радиосвязи."
    },
    {
      "id": "fact_19",
      "text": "Может определить стороны света по природным признакам."
    },
    {
      "id": "fact_20",
      "text": "Всю жизнь прожил(а) в большом городе."
    },
    {
      "id": "fact_21",
      "text": "Умеет шить одежду вручную."
    },
    {
      "id": "fact_22",
      "text": "Имеет опыт длительного похода."
    },
    {
      "id": "fact_23",
      "text": "Когда-то выступал(а) на большой сцене."
    },
    {
      "id": "fact_24",
      "text": "Знает несколько способов очистки воды."
    },
    {
      "id": "fact_25",
      "text": "Однажды спас(ла) человека."
    },
    {
      "id": "fact_26",
      "text": "Не умеет плавать."
    },
    {
      "id": "fact_27",
      "text": "Умеет играть на музыкальном инструменте."
    },
    {
      "id": "fact_28",
      "text": "Разбирается в съедобных дикорастущих растениях."
    },
    {
      "id": "fact_29",
      "text": "Имеет водительские права пяти категорий."
    },
    {
      "id": "fact_30",
      "text": "Может задерживать дыхание более двух минут."
    },
    {
      "id": "fact_31",
      "text": "Однажды провёл(а) месяц в одиночестве."
    },
    {
      "id": "fact_32",
      "text": "Знает основы консервирования продуктов."
    },
    {
      "id": "fact_33",
      "text": "Умеет ухаживать за домашним скотом."
    },
    {
      "id": "fact_34",
      "text": "В прошлом участвовал(а) в научной экспедиции."
    },
    {
      "id": "fact_35",
      "text": "Умеет быстро запоминать маршруты."
    },
    {
      "id": "fact_36",
      "text": "Имеет опыт жизни в палатке зимой."
    },
    {
      "id": "fact_37",
      "text": "Знает, как пользоваться огнетушителем."
    },
    {
      "id": "fact_38",
      "text": "Однажды оказался(ась) в эпицентре сильного землетрясения."
    },
    {
      "id": "fact_39",
      "text": "Может починить велосипед."
    },
    {
      "id": "fact_40",
      "text": "Умеет вести переговоры в конфликтной ситуации."
    },
    {
      "id": "fact_41",
      "text": "Имеет навыки ручной обработки дерева."
    },
    {
      "id": "fact_42",
      "text": "Знает основы выращивания грибов."
    },
    {
      "id": "fact_43",
      "text": "Умеет распознавать несколько видов ядовитых растений."
    },
    {
      "id": "fact_44",
      "text": "Никогда не летал(а) на самолёте."
    },
    {
      "id": "fact_45",
      "text": "Имеет опыт ухода за маленькими детьми."
    },
    {
      "id": "fact_46",
      "text": "Умеет экономно распределять запасы."
    },
    {
      "id": "fact_47",
      "text": "Однажды участвовал(а) в волонтёрской спасательной операции."
    },
    {
      "id": "fact_48",
      "text": "Может приготовить еду без рецепта."
    },
    {
      "id": "fact_49",
      "text": "Знает устройство простого двигателя."
    },
    {
      "id": "fact_50",
      "text": "Сохраняет спокойствие в чрезвычайных ситуациях."
    }
  ],
