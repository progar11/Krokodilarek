  "phobias": [
    {
      "id": "phobia_01",
      "text": "Клаустрофобия — страх замкнутых пространств."
    },
    {
      "id": "phobia_02",
      "text": "Акрофобия — страх высоты."
    },
    {
      "id": "phobia_03",
      "text": "Арахнофобия — страх пауков."
    },
    {
      "id": "phobia_04",
      "text": "Никтофобия — страх темноты."
    },
    {
      "id": "phobia_05",
      "text": "Аэрофобия — страх полётов."
    },
    {
      "id": "phobia_06",
      "text": "Гидрофобия — сильный страх воды."
    },
    {
      "id": "phobia_07",
      "text": "Трипанофобия — страх уколов."
    },
    {
      "id": "phobia_08",
      "text": "Мизофобия — страх грязи и микробов."
    },
    {
      "id": "phobia_09",
      "text": "Офидиофобия — страх змей."
    },
    {
      "id": "phobia_10",
      "text": "Танатофобия — страх смерти."
    },
    {
      "id": "phobia_11",
      "text": "Социофобия — страх общения с незнакомцами."
    },
    {
      "id": "phobia_12",
      "text": "Агорафобия — страх открытых пространств и толпы."
    },
    {
      "id": "phobia_13",
      "text": "Гемофобия — страх крови."
    },
    {
      "id": "phobia_14",
      "text": "Кинофобия — страх собак."
    },
    {
      "id": "phobia_15",
      "text": "Энтомофобия — страх насекомых."
    },
    {
      "id": "phobia_16",
      "text": "Бронтофобия — страх грома и молний."
    },
    {
      "id": "phobia_17",
      "text": "Пирофобия — страх огня."
    },
    {
      "id": "phobia_18",
      "text": "Сомнифобия — страх засыпания."
    },
    {
      "id": "phobia_19",
      "text": "Гефирофобия — страх мостов."
    },
    {
      "id": "phobia_20",
      "text": "Амаксофобия — страх поездок в транспорте."
    },
    {
      "id": "phobia_21",
      "text": "Монофобия — страх одиночества."
    },
    {
      "id": "phobia_22",
      "text": "Глоссофобия — страх публичных выступлений."
    },
    {
      "id": "phobia_23",
      "text": "Атихифобия — страх неудачи."
    },
    {
      "id": "phobia_24",
      "text": "Никтофобии нет, но боится полной тишины."
    },
    {
      "id": "phobia_25",
      "text": "Боится потерять контроль над ситуацией."
    },
    {
      "id": "phobia_26",
      "text": "Боится медицинских учреждений."
    },
    {
      "id": "phobia_27",
      "text": "Боится глубоких подземных помещений."
    },
    {
      "id": "phobia_28",
      "text": "Боится резких громких звуков."
    },
    {
      "id": "phobia_29",
      "text": "Боится больших скоплений людей."
    },
    {
      "id": "phobia_30",
      "text": "Фобий не имеет."
    }
  ],
